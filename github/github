#!/usr/bin/env python3
# Your GitHub: repos, pull requests, review requests, issues and notifications.
# @zunder.name        GitHub
# @zunder.prefix      gh
# @zunder.glyph
# @zunder.color       #6b5fd6
# @zunder.description Your repos, pull requests, review requests, issues and notifications
# @zunder.platforms   linux macos windows
# @zunder.setting     token "GitHub token (optional, falls back to the gh CLI). Classic with repo + notifications scope"
# @zunder.setting     limit "How many repos to list (default 100)"
import datetime as dt
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.request

CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "zunder")
REPOS = os.path.join(CACHE_DIR, "github-repos.json")
WORK = os.path.join(CACHE_DIR, "github-work.json")
REPOS_TTL = 600
WORK_TTL = 90
PREFIX = "gh "

# Nerd Font octicons
G_REPO, G_LOCK, G_FORK = "", "", ""
G_PR, G_DRAFT, G_REVIEW = "", "", ""
G_ISSUE, G_BELL, G_MENTION = "", "", ""
G_TAG, G_DISCUSS, G_PLAY, G_INBOX = "", "", "", ""
G_OK, G_FAIL, G_PENDING, G_COMMENT = "", "", "", ""

# first word of the query -> page
PAGES = {
    "pr": "prs", "prs": "prs", "pulls": "prs", "mr": "prs", "mrs": "prs",
    "review": "reviews", "reviews": "reviews",
    "issue": "issues", "issues": "issues",
    "notif": "notifs", "notifs": "notifs", "inbox": "notifs",
    "repo": "repos", "repos": "repos",
}

PR_FIELDS = """... on PullRequest {
  number title url isDraft createdAt updatedAt bodyText reviewDecision headRefName
  additions deletions changedFiles
  author { login } repository { nameWithOwner }
  comments { totalCount }
  labels(first: 6) { nodes { name } }
  commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
}"""
ISSUE_FIELDS = """... on Issue {
  number title url createdAt updatedAt bodyText
  author { login } repository { nameWithOwner }
  comments { totalCount }
  labels(first: 6) { nodes { name } }
}"""
WORK_QUERY = "{ viewer { login } %s }" % " ".join(
    f'{alias}: search(query: "{q} archived:false sort:updated-desc", type: ISSUE, first: 30) '
    f"{{ issueCount nodes {{ {fields} }} }}"
    for alias, q, fields in [
        ("prs", "is:open is:pr author:@me", PR_FIELDS),
        ("reviews", "is:open is:pr review-requested:@me", PR_FIELDS),
        ("assigned", "is:open is:issue assignee:@me", ISSUE_FIELDS),
        ("opened", "is:open is:issue author:@me", ISSUE_FIELDS),
    ])


def spawn_detached(args):
    """A background refresh that outlives this call (zunder kills the call on the next key)."""
    kw = {"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL, "stdin": subprocess.DEVNULL}
    if os.name != "nt":
        subprocess.Popen(args, start_new_session=True, **kw)
        return
    # no console window; leave zunder's job object when it allows that
    flags = subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP
    try:
        subprocess.Popen(args, creationflags=flags | 0x01000000, **kw)  # CREATE_BREAKAWAY_FROM_JOB
    except OSError:
        subprocess.Popen(args, creationflags=flags, **kw)


def limit():
    try:
        return max(1, int(os.environ.get("ZUNDER_LIMIT", "100")))
    except ValueError:
        return 100


def token():
    return os.environ.get("ZUNDER_TOKEN", "").strip()


def api(path, body=None):
    """GET (or POST a JSON body to) the GitHub API, with the token or through gh."""
    t = token()
    if t:
        req = urllib.request.Request(
            "https://api.github.com/" + path, data=json.dumps(body).encode() if body else None,
            headers={"Authorization": f"Bearer {t}", "Accept": "application/vnd.github+json",
                     "User-Agent": "zunder-github-plugin"})
        with urllib.request.urlopen(req, timeout=15) as r:
            out = json.load(r)
    else:
        if not shutil.which("gh"):
            raise RuntimeError("set a token in Settings → Plugins or install gh")
        args = ["gh", "api", path]
        if body:
            args += ["--input", "-"]
        r = subprocess.run(args, input=json.dumps(body) if body else None,
                           capture_output=True, text=True, timeout=30, encoding="utf-8")
        if r.returncode != 0:
            raise RuntimeError((r.stderr.strip().splitlines() or ["gh failed"])[-1])
        out = json.loads(r.stdout)
    if isinstance(out, dict) and out.get("errors") and not out.get("data"):
        raise RuntimeError(out["errors"][0].get("message", "GraphQL error"))
    return out


def write_cache(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f)
    os.replace(tmp, path)


# ---- repos ---------------------------------------------------------------------------------

def fetch_repos(n):
    repos, page = [], 1
    while len(repos) < n:
        batch = api(f"user/repos?per_page=100&sort=pushed&page={page}")
        repos += [{"name": b["full_name"], "description": b.get("description") or "",
                   "url": b["html_url"], "ssh": b["ssh_url"], "private": b["private"],
                   "fork": b.get("fork", False), "stars": b["stargazers_count"]} for b in batch]
        if len(batch) < 100:
            break
        page += 1
    return repos[:n]


def refresh_repos():
    repos = fetch_repos(limit())
    write_cache(REPOS, repos)
    return repos


# ---- pull requests, issues, notifications --------------------------------------------------

def pr_row(n, kind):
    rollup = ((n.get("commits") or {}).get("nodes") or [{}])[0].get("commit", {}).get("statusCheckRollup")
    return {"kind": kind, "number": n["number"], "title": n["title"], "url": n["url"],
            "repo": n["repository"]["nameWithOwner"], "author": (n.get("author") or {}).get("login", "ghost"),
            "created": n["createdAt"], "updated": n["updatedAt"], "body": (n.get("bodyText") or "")[:1200],
            "draft": n.get("isDraft", False), "review": n.get("reviewDecision"),
            "ci": (rollup or {}).get("state"), "branch": n.get("headRefName", ""),
            "additions": n.get("additions", 0), "deletions": n.get("deletions", 0),
            "files": n.get("changedFiles", 0), "comments": n["comments"]["totalCount"],
            "labels": [l["name"] for l in n["labels"]["nodes"]]}


def issue_row(n, why):
    return {"kind": "issue", "why": why, "number": n["number"], "title": n["title"], "url": n["url"],
            "repo": n["repository"]["nameWithOwner"], "author": (n.get("author") or {}).get("login", "ghost"),
            "created": n["createdAt"], "updated": n["updatedAt"], "body": (n.get("bodyText") or "")[:1200],
            "comments": n["comments"]["totalCount"], "labels": [l["name"] for l in n["labels"]["nodes"]]}


def html_url(subject, repo_url):
    """api.github.com/repos/o/r/pulls/3 -> github.com/o/r/pull/3; anything else -> the repo."""
    u = subject.get("url") or ""
    if "/pulls/" in u or "/issues/" in u:
        return u.replace("://api.github.com/repos/", "://github.com/").replace("/pulls/", "/pull/")
    if subject.get("type") == "Release":
        return repo_url + "/releases"
    if subject.get("type") == "Discussion":
        return repo_url + "/discussions"
    if subject.get("type") == "CheckSuite":
        return repo_url + "/actions"
    return repo_url


def fetch_notifs():
    out = []
    for n in api("notifications?per_page=50"):
        repo = n["repository"]
        out.append({"kind": "notif", "id": n["id"], "title": n["subject"]["title"],
                    "type": n["subject"]["type"], "reason": n["reason"],
                    "repo": repo["full_name"], "updated": n["updated_at"],
                    "url": html_url(n["subject"], repo["html_url"])})
    return out


def refresh_work():
    work = {"fetched": time.time()}
    try:
        d = api("graphql", {"query": WORK_QUERY})["data"]
        work["login"] = d["viewer"]["login"]
        work["prs"] = [pr_row(n, "pr") for n in d["prs"]["nodes"] if n]
        work["reviews"] = [pr_row(n, "review") for n in d["reviews"]["nodes"] if n]
        seen, issues = set(), []
        for why, key in (("assigned", "assigned"), ("opened by you", "opened")):
            for n in d[key]["nodes"]:
                if n and n["url"] not in seen:
                    seen.add(n["url"])
                    issues.append(issue_row(n, why))
        issues.sort(key=lambda i: i["updated"], reverse=True)
        work["issues"] = issues
    except Exception as e:
        work["error"] = str(e)
    try:
        work["notifs"] = fetch_notifs()
    except Exception as e:  # fine-grained tokens can't read notifications
        work["notifs_error"] = str(e)
    write_cache(WORK, work)
    return work


def load(path, ttl, refresh, block=True):
    """Cached data; a stale cache is used as is and refreshed in the background.

    Without a cache, block=False starts the refresh and returns None instead of waiting."""
    try:
        age = time.time() - os.path.getmtime(path)
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        if block:
            return refresh()
        data, age = None, ttl + 1
    if isinstance(data, dict) and data.get("error"):
        ttl = min(ttl, 10)  # retry soon after a fixed token or a network blip
    if age > ttl:
        try:
            if data is not None:
                os.utime(path)  # one refresh at a time, not one per keystroke
            elif os.path.exists(path + ".lock") and time.time() - os.path.getmtime(path + ".lock") < 30:
                return None
            else:
                os.makedirs(CACHE_DIR, exist_ok=True)
                open(path + ".lock", "w").close()
        except OSError:
            pass
        spawn_detached([sys.executable, os.path.realpath(__file__), "--refresh-" + os.path.basename(path)])
    return data


# ---- rows ----------------------------------------------------------------------------------

def ago(stamp):
    try:
        t = dt.datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc)
    except (TypeError, ValueError):
        return ""
    s = (dt.datetime.now(dt.timezone.utc) - t).total_seconds()
    for unit, size in (("y", 31536000), ("mo", 2592000), ("w", 604800), ("d", 86400), ("h", 3600), ("m", 60)):
        if s >= size:
            return f"{int(s // size)}{unit}"
    return "now"


CI = {"SUCCESS": (G_OK, "passing"), "FAILURE": (G_FAIL, "failing"), "ERROR": (G_FAIL, "failing"),
      "PENDING": (G_PENDING, "running"), "EXPECTED": (G_PENDING, "waiting")}
REVIEW = {"APPROVED": (G_OK, "approved"), "CHANGES_REQUESTED": (G_FAIL, "changes requested"),
          "REVIEW_REQUIRED": (G_PENDING, "needs review")}
REASON = {"review_requested": "review requested", "mention": "mentioned", "team_mention": "team mentioned",
          "assign": "assigned", "author": "you opened it", "comment": "you commented",
          "ci_activity": "CI", "state_change": "state changed", "subscribed": "watching",
          "manual": "subscribed", "security_alert": "security alert", "invitation": "invitation",
          "approval_requested": "approval requested"}
NOTIF_GLYPH = {"PullRequest": G_PR, "Issue": G_ISSUE, "Release": G_TAG, "Discussion": G_DISCUSS,
               "CheckSuite": G_PLAY}


def matches(words, *fields):
    hay = " ".join(f for f in fields if f).lower()
    return all(w in hay for w in words)


def emit(row):
    print(json.dumps(row, ensure_ascii=False), flush=True)


def item_preview(i):
    lines = [f"{i['repo']} #{i['number']}", i["title"], ""]
    lines.append(f"by {i['author']} · opened {ago(i['created'])} ago · updated {ago(i['updated'])} ago")
    if i["kind"] != "issue":
        files = f"{i['files']} file" + ("" if i["files"] == 1 else "s")
        lines.append(f"{i['branch']} · +{i['additions']} −{i['deletions']} in {files}")
        if i.get("ci") in CI:
            lines.append(f"CI: {CI[i['ci']][1]}")
        if i.get("review") in REVIEW:
            lines.append(f"Review: {REVIEW[i['review']][1]}")
        if i.get("draft"):
            lines.append("Draft")
    else:
        lines.append(i["why"].capitalize())
    if i["comments"]:
        lines.append(f"{i['comments']} comment" + ("" if i["comments"] == 1 else "s"))
    if i["labels"]:
        lines.append("Labels: " + ", ".join(i["labels"]))
    if i["body"].strip():
        lines += ["", i["body"].strip()]
    return "\n".join(lines)


def item_rows(items, words):
    for i in items:
        if not matches(words, i["title"], i["repo"], f"#{i['number']}", " ".join(i["labels"]),
                       i.get("branch"), i.get("author")):
            continue
        hint = []
        if i["kind"] == "issue":
            glyph = G_ISSUE
            hint.append(i["why"])
        else:
            glyph = G_DRAFT if i["draft"] else (G_REVIEW if i["kind"] == "review" else G_PR)
            if i["kind"] == "review":
                hint.append(i["author"])
            if i["draft"]:
                hint.append("draft")
            if i.get("ci") in CI:
                hint.append(" ".join(CI[i["ci"]]))
            if i.get("review") in REVIEW and not i["draft"]:
                hint.append(" ".join(REVIEW[i["review"]]))
        if i["comments"]:
            hint.append(f"{G_COMMENT} {i['comments']}")
        hint.append(ago(i["updated"]))
        actions = [{"title": "Copy URL", "copy": i["url"], "glyph": ""},
                   {"title": f"Copy {i['repo']}#{i['number']}", "copy": f"{i['repo']}#{i['number']}"}]
        if i["kind"] != "issue":
            actions += [{"title": "Open changed files", "open": i["url"] + "/files", "glyph": G_REVIEW},
                        {"title": "Open checks", "open": i["url"] + "/checks", "glyph": G_PLAY},
                        {"title": "Copy branch name", "copy": i["branch"]},
                        {"title": "Copy checkout command",
                         "copy": f"gh pr checkout {i['number']} -R {i['repo']}"}]
        actions.append({"title": f"Open {i['repo']}", "open": i["url"].rsplit("/", 2)[0], "glyph": G_REPO})
        emit({"title": i["title"], "subtitle": f"{i['repo']} #{i['number']}", "hint": " · ".join(hint),
              "glyph": glyph, "preview": item_preview(i), "action": {"open": i["url"]}, "actions": actions})


def notif_rows(notifs, words):
    for n in notifs:
        reason = REASON.get(n["reason"], n["reason"].replace("_", " "))
        if not matches(words, n["title"], n["repo"], reason, n["type"]):
            continue
        glyph = G_MENTION if n["reason"] in ("mention", "team_mention") else NOTIF_GLYPH.get(n["type"], G_BELL)
        emit({"title": n["title"], "subtitle": n["repo"], "hint": f"{reason} · {ago(n['updated'])}",
              "glyph": glyph, "action": {"open": n["url"]},
              "actions": [{"title": "Copy URL", "copy": n["url"]},
                          {"title": "Open all notifications", "open": "https://github.com/notifications",
                           "glyph": G_INBOX}]})


def repo_rows(repos, words):
    for r in repos:
        if not matches(words, r["name"], r["description"]):
            continue
        hint = list(filter(None, ["fork" if r.get("fork") else "", "private" if r["private"] else "",
                                  f"★ {r['stars']}" if r["stars"] else ""]))
        emit({
            "title": r["name"],
            "subtitle": r["description"][:100],
            "hint": " · ".join(hint),
            "glyph": G_LOCK if r["private"] else (G_FORK if r.get("fork") else G_REPO),
            "action": {"open": r["url"]},
            "actions": [{"title": "Copy URL", "copy": r["url"]},
                        {"title": "Copy SSH clone URL", "copy": r["ssh"]},
                        {"title": "Open issues", "open": r["url"] + "/issues", "glyph": G_ISSUE},
                        {"title": "Open pull requests", "open": r["url"] + "/pulls", "glyph": G_PR},
                        {"title": "New issue", "open": r["url"] + "/issues/new", "glyph": G_ISSUE},
                        {"title": "Open actions", "open": r["url"] + "/actions", "glyph": G_PLAY},
                        {"title": "Filter my PRs and issues here", "fill": f"{PREFIX}{r['name']} ",
                         "glyph": G_INBOX}],
        })


def error_row(msg):
    emit({"title": "GitHub: " + msg.splitlines()[0][:200], "glyph": G_FAIL,
          "hint": "Settings → Plugins", "action": {"copy": msg}})


def menu(work):
    def count(key):
        if work is None:
            return "…"
        n = len(work.get(key) or [])
        return str(n) if n else ""
    entries = [
        ("Pull requests", "your open PRs", "pr", G_PR, "prs", "https://github.com/pulls"),
        ("Review requests", "PRs waiting on your review", "review", G_REVIEW, "reviews",
         "https://github.com/pulls/review-requested"),
        ("Issues", "assigned to you or opened by you", "issues", G_ISSUE, "issues", "https://github.com/issues"),
        ("Notifications", "unread", "notif", G_BELL, "notifs", "https://github.com/notifications"),
    ]
    for title, sub, word, glyph, key, url in entries:
        emit({"title": title, "subtitle": sub, "hint": count(key), "glyph": glyph,
              "action": {"fill": f"{PREFIX}{word} "},
              "actions": [{"title": "Open on github.com", "open": url}]})


def main():
    if hasattr(sys.stdout, "reconfigure"):  # Windows pipes default to the ANSI code page
        sys.stdout.reconfigure(encoding="utf-8")
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg.startswith("--refresh"):
        target = arg[len("--refresh-"):]
        try:
            refresh_work() if target == os.path.basename(WORK) else refresh_repos()
        finally:
            try:
                os.remove(WORK + ".lock" if target == os.path.basename(WORK) else REPOS + ".lock")
            except OSError:
                pass
        return
    words = arg.lower().split()
    page = PAGES.get(words[0]) if words else None
    if page:
        words = words[1:]

    if page in ("prs", "reviews", "issues", "notifs"):
        try:
            work = load(WORK, WORK_TTL, refresh_work)
        except Exception as e:
            sys.exit(f"GitHub: {e}")
        if page == "notifs":
            if work.get("notifs_error"):
                error_row("notifications: " + work["notifs_error"])
            elif not work.get("notifs"):
                emit({"title": "No unread notifications", "glyph": G_INBOX,
                      "action": {"open": "https://github.com/notifications"}})
            notif_rows(work.get("notifs") or [], words)
            return
        if work.get("error"):
            error_row(work["error"])
            return
        items = work.get(page) or []
        if not items and not words:
            empty = {"prs": "No open pull requests", "reviews": "Nothing waiting on your review",
                     "issues": "No open issues for you"}[page]
            emit({"title": empty, "glyph": G_OK, "action": {"fill": PREFIX}})
        item_rows(items, words)
        return

    # repo search; with no words, the menu goes first
    work = load(WORK, WORK_TTL, refresh_work, block=False) if page is None else None
    if not words and page is None:
        menu(work)
    try:
        repos = load(REPOS, REPOS_TTL, refresh_repos)
    except Exception as e:  # network, auth, gh missing: show it as the result
        if not words and page is None:
            error_row(str(e))
            return
        sys.exit(f"GitHub: {e}")
    repo_rows(repos, words)
    # typing a repo or a word also finds your open PRs and issues that match it
    if words and work and not work.get("error"):
        item_rows((work.get("prs") or []) + (work.get("reviews") or []) + (work.get("issues") or []), words)


if __name__ == "__main__":
    main()
