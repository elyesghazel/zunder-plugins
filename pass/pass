#!/usr/bin/env python3
# Search pass / gopass entries; Enter copies the password, Ctrl+K copies the username.
# @zunder.name        Passwords
# @zunder.prefix      pass
# @zunder.glyph       
# @zunder.description Search pass or gopass entries and copy passwords or usernames
# @zunder.requires    wl-copy
# @zunder.platforms   linux
# @zunder.setting     backend "pass or gopass (default: gopass if installed, else pass)"
import json
import os
import shlex
import shutil
import subprocess
import sys

SELF = shlex.quote(os.path.realpath(__file__))
USER_KEYS = ("user", "username", "login", "email")


def backend():
    want = os.environ.get("ZUNDER_BACKEND", "").strip()
    if want in ("pass", "gopass"):
        return want
    return "gopass" if shutil.which("gopass") else "pass"


def entries(tool):
    if tool == "gopass":
        r = subprocess.run(["gopass", "ls", "--flat"], capture_output=True, text=True, timeout=5)
        return r.stdout.splitlines()
    store = os.path.expanduser(os.environ.get("PASSWORD_STORE_DIR", "~/.password-store"))
    out = []
    for root, dirs, files in os.walk(store, followlinks=True):
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        for f in files:
            if f.endswith(".gpg"):
                out.append(os.path.relpath(os.path.join(root, f[:-4]), store))
    return sorted(out)


def username(tool, entry):
    """First `user:`/`login:`/... line of the entry, else the last path component."""
    r = subprocess.run([tool, "show", entry], capture_output=True, text=True, timeout=30)
    for line in r.stdout.splitlines()[1:]:
        key, sep, value = line.partition(":")
        if sep and key.strip().lower() in USER_KEYS and value.strip():
            return value.strip()
    return os.path.basename(entry)


def main():
    tool = backend()
    if not shutil.which(tool):
        sys.exit(f"{tool} not found")
    if len(sys.argv) > 2 and sys.argv[1] == "--user":
        subprocess.run(["wl-copy"], input=username(tool, sys.argv[2]), text=True, check=True)
        if shutil.which("notify-send"):
            subprocess.run(["notify-send", "Username copied", sys.argv[2]], check=False)
        return
    words = (sys.argv[1] if len(sys.argv) > 1 else "").lower().split()
    shown = 0
    for e in entries(tool):
        if not all(w in e.lower() for w in words):
            continue
        q = shlex.quote(e)
        print(json.dumps({
            "title": e,
            "subtitle": "Enter copies the password",
            "hint": tool,
            "action": {"run": f"{tool} show -c {q}" if tool == "gopass" else f"pass -c {q}"},
            "actions": [{"title": "Copy username", "glyph": "", "run": f"{SELF} --user {q}"},
                        {"title": "Edit", "glyph": "", "term": f"{tool} edit {q}"}],
        }, ensure_ascii=False))
        shown += 1
        if shown >= 200:
            break


if __name__ == "__main__":
    main()
