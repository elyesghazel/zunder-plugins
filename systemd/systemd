#!/usr/bin/env python3
# User and system services; status in the preview, Ctrl+K starts, stops or restarts.
# @zunder.name        Services
# @zunder.prefix      sd
# @zunder.glyph       
# @zunder.description Search systemd user and system services, start, stop or restart them
# @zunder.requires    systemctl
# @zunder.platforms   linux
import json
import os
import shlex
import shutil
import subprocess
import sys
import time

PROPS = "Id,Description,ActiveState,SubState,ActiveEnterTimestamp,MainPID,MemoryCurrent,UnitFileState,FragmentPath"
PREVIEWS = 10
CACHE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", f"zunder-systemd-{os.getuid()}.json")
CACHE_TTL = 5  # seconds; details are fetched once while you type, not per keystroke
GLYPH = {"active": "", "failed": "", "activating": "", "deactivating": ""}


def spawn(*args):
    return subprocess.Popen(["systemctl", *args], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                            text=True)


def units(procs):
    """Run in parallel: both scopes at once keeps a call well under 100 ms."""
    out = []
    for scope, p in procs:
        try:
            out += [dict(u, scope=scope) for u in json.loads(p.communicate(timeout=5)[0] or "[]")
                    if u.get("load") != "not-found"]
        except (ValueError, subprocess.TimeoutExpired):
            p.kill()
    return out


def details(procs):
    out = {}
    for scope, p in procs:
        try:
            stdout = p.communicate(timeout=5)[0]
        except subprocess.TimeoutExpired:
            p.kill()
            continue
        for block in stdout.split("\n\n"):
            props = dict(line.split("=", 1) for line in block.splitlines() if "=" in line)
            if props.get("Id"):
                out[(scope, props["Id"])] = props
    return out


def memory(v):
    try:
        n = int(v)
    except (TypeError, ValueError):
        return ""
    if n >= 2 ** 63:  # [not set]
        return ""
    for unit in ("B", "K", "M", "G"):
        if n < 1024:
            return f"{n:.0f}{unit}"
        n /= 1024
    return f"{n:.1f}T"


def preview(u, d):
    lines = [f"{u['unit']} ({u['scope']})", u.get("description", ""), "",
             f"state    {u['active']} ({u['sub']})"]
    if d.get("ActiveEnterTimestamp"):
        lines.append(f"since    {d['ActiveEnterTimestamp']}")
    if d.get("MainPID", "0") != "0":
        lines.append(f"pid      {d['MainPID']}")
    if memory(d.get("MemoryCurrent")):
        lines.append(f"memory   {memory(d.get('MemoryCurrent'))}")
    if d.get("UnitFileState"):
        lines.append(f"enabled  {d['UnitFileState']}")
    if d.get("FragmentPath"):
        lines.append(f"file     {d['FragmentPath']}")
    return "\n".join(lines)


def main():
    if not shutil.which("systemctl"):
        sys.exit("systemctl not found: this plugin needs systemd")
    words = (sys.argv[1] if len(sys.argv) > 1 else "").lower().split()
    found = [u for u in units([(s, spawn(f"--{s}", "list-units", "--type=service", "--all",
                                         "--no-pager", "-o", "json")) for s in ("user", "system")])
             if all(w in f"{u['unit']} {u.get('description', '')} {u['scope']} {u['active']}".lower()
                    for w in words)]
    found.sort(key=lambda u: (u["active"] != "failed", u["active"] != "active", u["scope"] != "user",
                              u["unit"]))
    found = found[:60]
    try:
        with open(CACHE) as f:
            cache = {tuple(k.split("/", 1)): v for k, v in json.load(f).items()
                     if time.time() - v["t"] < CACHE_TTL}
    except (OSError, ValueError):
        cache = {}
    procs = []
    for scope in ("user", "system"):
        names = [u["unit"] for u in found[:PREVIEWS] if u["scope"] == scope and (scope, u["unit"]) not in cache]
        if names:
            procs.append((scope, spawn(f"--{scope}", "show", "--no-pager", "-p", PROPS, *names)))
    fresh = details(procs)
    if fresh:
        cache.update({k: dict(v, t=time.time()) for k, v in fresh.items()})
        try:
            with open(CACHE + ".tmp", "w") as f:
                json.dump({"/".join(k): v for k, v in cache.items()}, f)
            os.replace(CACHE + ".tmp", CACHE)
        except OSError:
            pass
    info = cache

    for u in found:
        name, scope = u["unit"], u["scope"]
        ctl = f"systemctl --{scope}"
        q = shlex.quote(name)
        journal = f"journalctl {'--user ' if scope == 'user' else ''}-u {q}"
        row = {
            "title": name.removesuffix(".service"),
            "subtitle": u.get("description", ""),
            "hint": f"{scope} · {u['active']}" + (f" ({u['sub']})" if u["sub"] not in ("running", "dead") else ""),
            "glyph": GLYPH.get(u["active"], ""),
            "action": {"term": f"{ctl} status --no-pager {q}; {journal} -n 30 --no-pager"},
            "actions": [{"title": "Start", "glyph": "", "run": f"{ctl} start {q}"},
                        {"title": "Stop", "glyph": "", "run": f"{ctl} stop {q}"},
                        {"title": "Restart", "glyph": "", "run": f"{ctl} restart {q}"},
                        {"title": "Follow logs", "glyph": "", "term": f"{journal} -f"}],
            "preview": preview(u, info.get((scope, name), {})),
        }
        print(json.dumps(row, ensure_ascii=False))


if __name__ == "__main__":
    main()
